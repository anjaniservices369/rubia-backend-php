{
    "name":  "yiisoft/yii2-app-basic",
    "description":  "Yii 2 Basic Project Template",
    "keywords":  [
                     "yii2",
                     "framework",
                     "basic",
                     "project template"
                 ],
    "homepage":  "http://www.yiiframework.com/",
    "type":  "project",
    "license":  "BSD-3-Clause",
    "support":  {
                    "issues":  "https://github.com/yiisoft/yii2/issues?state=open",
                    "forum":  "http://www.yiiframework.com/forum/",
                    "wiki":  "http://www.yiiframework.com/wiki/",
                    "irc":  "irc://irc.freenode.net/yii",
                    "source":  "https://github.com/yiisoft/yii2"
                },
    "minimum-stability":  "stable",
    "require":  {
                    "php":  "\u003e=7.0",
                    "yiisoft/yii2":  "~2.0.5",
                    "yiisoft/yii2-bootstrap":  "~2.0.0",
                    "yiisoft/yii2-symfonymailer": "^4.0",
                    "miloschuman/yii2-highcharts-widget": "^11.0",
                    "yiisoft/yii2-bootstrap4":  "^2.0",
                    "kartik-v/yii2-datecontrol":  "dev-master",
                    "almasaeed2010/adminlte": "^4.0",   "yiisoft/yii2-bootstrap5": "^2.0",
		"kartik-v/yii2-bootstrap5-dropdown": "@dev",
		"npm-asset/fortawesome--fontawesome-free": "^7.0",
                    "kriss/yii2-log-reader":  "2.*",
                    "mootensai/yii2-relation-trait":  "dev-master",
                    "yiisoft/yii2-jui":  "^2.0",
                    "kartik-v/yii2-widget-activeform":  "dev-master",
                    "kartik-v/yii2-widget-select2":  "dev-master",
                    "kartik-v/yii2-grid":  "@dev",
                    "kartik-v/yii2-export":  "dev-master",
                    "kartik-v/yii2-tabs-x":  "dev-master",
                    "kartik-v/yii2-widgets":  "@dev",
                    "kingston-kms/yii2-mdbootstrap": "^2.0",
                    "kartik-v/yii2-date-range":  "dev-master",
                    "warrence/yii2-kartikgii":  "dev-master",
                    "mootensai/yii2-enhanced-gii":  "dev-master",
                    "kartik-v/yii2-mpdf":  "dev-master",
                    "kartik-v/yii2-tree-manager":  "dev-master",
                    "sjaakp/yii2-loadmore":  "^1.0",
                    "kartik-v/yii2-widget-typeahead":  "@dev",
                    "unclead/yii2-multiple-input":  "~2.0",
                    "yiisoft/yii2-authclient":  "*",
                    "pigochu/yii2-jquery-locationpicker":  "\u003e=0.2.0",
                    "kartik-v/yii2-bootstrap4-dropdown":  "@dev",
                    "mihaildev/yii2-ckeditor":  "*",
                    "beaten-sect0r/yii2-db-manager": "~1.0.3",
        "lcobucci/jwt": "^5.0"
                },
    "require-dev":  {
                        "yiisoft/yii2-debug": "^2.1",
                        "yiisoft/yii2-gii": "^2.2",
                        "yiisoft/yii2-faker":  "~2.0.0"
                    },
    "config":  {
                   "process-timeout":  1800,
                   "allow-plugins":  {
                                         "yiisoft/yii2-composer":  true
                                     },
                   "policy":  {
                                  "advisories":  {
                                                     "ignore-id":  [
                                                                       "PKSA-rkkf-636k-qjb3",
                                                                       "PKSA-wws7-mr54-jsny"
                                                                   ]
                                                 }
                              }
               },
    "scripts":  {
                    "post-install-cmd":  [
                                             "yii\\composer\\Installer::postInstall"
                                         ],
                    "post-create-project-cmd":  [
                                                    "yii\\composer\\Installer::postCreateProject",
                                                    "yii\\composer\\Installer::postInstall"
                                                ]
                },
    "extra":  {
                  "yii\\composer\\Installer::postCreateProject":  {
                                                                      "setPermission":  [
                                                                                            {
                                                                                                "runtime":  "0777",
                                                                                                "web/assets":  "0777",
                                                                                                "yii":  "0755"
                                                                                            }
                                                                                        ]
                                                                  },
                  "yii\\composer\\Installer::postInstall":  {
                                                                "generateCookieValidationKey":  [
                                                                                                    "config/web.php"
                                                                                                ]
                                                            }
              },
    "repositories":  [
                         {
                             "type":  "composer",
                             "url":  "https://asset-packagist.org"
                         }
                     ]
}
