{
  "service": "customer",
  "title": "Customer app",
  "include": [
    "app",
    "libs/platform",
    "customer",
    "DEPLOY.md"
  ],
  "exclude": [
    "app/runtime",
    "app/uploads",
    "app/uploads_bkp",
    "app/backups",
    "app/config/secrets.php",
    "app/config/db_bkp.php",
    "app/web/index-test.php",
    "app/glue",
    "app/modules/managerapp",
    "app/modules/comingsoon",
    "app/web/haltingdriver.php",
    "app/web/haltingdriver-dashboard.php",
    "app/web/cartaxi.php",
    "app/web/cartaxi-dashboard.php",
    "app/web/autotaxi.php",
    "app/web/autotaxi-dashboard.php",
    "app/web/biketaxi.php",
    "app/web/biketaxi-dashboard.php",
    "customer/release/dist"
  ],
  "excludeSuffixes": [
    ".bak",
    ".zip",
    ".log"
  ],
  "excludePatterns": [
    "^app/assets/[0-9a-f]{6,8}/",
    "^app/web/assets/",
    "^app/vendor/[^/]+/[^/]+/(tests?|docs?|examples?)/"
  ],
  "emptyDirs": [
    "app/runtime",
    "app/web/assets"
  ],
  "profiles": {
    "api": {
      "excludePatterns": [
        "^app/vendor/(npm-asset|bower-asset|almasaeed2010|twbs|select2)/",
        "^app/vendor/kartik-v/yii2-icons/",
        "^app/vendor/(fakerphp|phpspec|yiisoft/yii2-(debug|faker|gii))/",
        "^app/themes/",
        "^app/assets/",
        "^app/web/(css|images|js)/",
        "^app/modules/admin/views/",
        "^customer/dashboard/views/"
      ],
      "exclude": [
        "app/web/customer-dashboard.php",
        "app/web/_dashboard.php",
        "app/web/index.php",
        "app/index.php"
      ],
      "note": "API process only: no dashboard views or front-end asset packages."
    }
  }
}